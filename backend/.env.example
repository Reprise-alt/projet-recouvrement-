DATABASE_URL="postgresql://user:password@localhost:5432/recouvrement?schema=public"
PORT=3000

# JWT secret shared with Supabase Auth (Project Settings > API > JWT Secret).
# Used to verify tokens issued by Supabase for logged-in users.
SUPABASE_JWT_SECRET=

# development | production — controls whether /api/auth/dev-token (local
# testing helper, no real Supabase project needed) is enabled. Must never be
# "development" in a deployed environment.
NODE_ENV=development

# Google Cloud OAuth2 client (Console > APIs & Services > Credentials) for
# the dedicated Gmail account (ex: recouvrement@soram-afrique.com). Redirect
# URI must be registered on the OAuth client and point at this backend's
# /api/integrations/gmail/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Optional: if set, the Gmail OAuth callback redirects back here (?gmail=connected
# or ?gmail=error) instead of showing a plain confirmation page.
FRONTEND_URL=http://localhost:5173
