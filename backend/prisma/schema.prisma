generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatutFacture {
  impayee
  payee
}

enum RoleUtilisateur {
  admin
  manager_entite
  comptable
}

// Rôle propre au module Opérations -- orthogonal à RoleUtilisateur (qui régit
// le recouvrement) : un utilisateur peut avoir l'un, l'autre, les deux, ou
// aucun. Nullable sur Utilisateur = pas d'accès au module Opérations.
// - directrice_operations : lecture/écriture complète, scopée à son entité
//   (via Utilisateur.entite, déjà utilisé côté recouvrement pour le même rôle
//   de portée).
// - charge_compte : relevé/problèmes/engagements, mais uniquement sur les
//   comptes dont il est le charge de compte (ClientOperations.chargeDeCompte).
// - direction_generale : lecture des deux entités + arbitrage VIP +
//   administration des seuils/nomenclatures. Utilisateur.entite = null,
//   comme pour le rôle admin côté recouvrement.
enum RoleOperations {
  directrice_operations
  charge_compte
  direction_generale
}

enum ServiceIntegration {
  artis
  mapon
  gmail
}

enum StatutIntegration {
  actif
  inactif
}

// Rythme de facturation d'un client — les gros comptes payant à un rythme
// trimestriel ou annuel ne doivent pas être jugés "en retard" avec la même
// échelle qu'un client mensuel (cf. multiplicateur dans lib/paliers.ts).
enum FrequenceFacturation {
  mensuelle
  trimestrielle
  annuelle
}

// Liste des entités du groupe (SORAM, SIS, IRIS…), gérable depuis
// l'interface (admin) plutôt que figée dans un type — permet d'ajouter une
// nouvelle entreprise sans migration de schéma. `code` est ce qui est stocké
// tel quel dans Client.entite / Utilisateur.entite / IntegrationCredential.entite
// (pas de clé étrangère stricte, pour ne pas bloquer un import sur une entité
// pas encore créée) ; `estCommun` marque l'entité spéciale partagée par
// toutes les autres (remplace l'ancienne valeur figée "COMMUN").
model Entreprise {
  id        String   @id @default(cuid())
  code      String   @unique
  nom       String
  estCommun Boolean  @default(false)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Client {
  id                   String               @id @default(cuid())
  nom                  String
  entite               String
  contact              String?
  email                String?
  tel                  String?
  note                 String?
  prochaineRelance     DateTime?
  frequenceFacturation FrequenceFacturation @default(mensuelle)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Identifiant groupe partagé avec le module Opérations -- permet de
  // rapprocher la fiche recouvrement d'une entité et la fiche opérations de
  // la même société physique sans jamais comparer des noms ("SEN'EAU" vs
  // "Sen Eau SA" ne se rejoindraient jamais). Volontairement pas @unique
  // seul : une même société peut porter le même codeClient sur sa ligne
  // SORAM et sa ligne IRIS -- l'unicité se vérifie par entité (voir index
  // ci-dessous). Nullable : tous les clients recouvrement existants n'ont
  // pas vocation à exister côté Opérations.
  codeClient String?

  factures              Facture[]
  contrats              Contrat[]
  actions               ActionRecouvrement[]
  contacts              Contact[]
  echeanciers           EcheancierPaiement[]
  tachesCoursier        TacheCoursier[]
  tachesCoursierModeles TacheCoursierModele[]
  operations            ClientOperations?
  dossiersContentieux   DossierContentieux[]

  // Clé de rapprochement à l'import (Excel manuel aujourd'hui, sync ARTIS/MAPON demain) :
  // un même client ne doit jamais être dupliqué d'un import à l'autre.
  @@unique([nom, entite])
  @@unique([codeClient, entite])
}

// Accord de règlement échelonné négocié avec un client en difficulté —
// distinct des factures elles-mêmes (une tranche ne correspond pas
// forcément à une facture précise) pour pouvoir suivre le respect de
// l'accord indépendamment du détail de facturation.
model EcheancierPaiement {
  id           String   @id @default(cuid())
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  montantTotal Float
  motif        String?
  createdAt    DateTime @default(now())

  tranches TranchePaiement[]
}

model TranchePaiement {
  id           String             @id @default(cuid())
  echeancier   EcheancierPaiement @relation(fields: [echeancierId], references: [id], onDelete: Cascade)
  echeancierId String
  ordre        Int
  dateEcheance DateTime
  montant      Float
  statut       StatutFacture      @default(impayee)
  datePaiement DateTime?
}

// Contacts supplémentaires d'un client (au-delà du contact principal
// contact/email/tel ci-dessus, alimenté par l'import Excel) — gérés
// manuellement depuis la fiche client par les agents (plusieurs
// interlocuteurs chez un même client : comptabilité, direction, etc.).
model Contact {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  nom       String
  fonction  String?
  email     String?
  tel       String?
  createdAt DateTime @default(now())
}

model Facture {
  id           String        @id @default(cuid())
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  numero       String
  montant      Float
  montantHT    Float?
  dateFacture  DateTime?
  dateEcheance DateTime
  statut       StatutFacture @default(impayee)
  datePaiement DateTime?
  modePaiement String?
  numPiece     String?
  remisSur     String?
  designation  String?
  commercial   String?
  traitePar    String?
  etatFactures String?
  dateDepot    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Rattachement optionnel à un dossier contentieux : une facture impayée peut
  // être versée à un dossier de recouvrement judiciaire. Nullable (la grande
  // majorité des factures ne passe jamais au contentieux) ; SetNull pour ne
  // pas perdre la facture si le dossier est supprimé.
  dossierContentieux   DossierContentieux? @relation(fields: [dossierContentieuxId], references: [id], onDelete: SetNull)
  dossierContentieuxId String?

  // Clé de fusion à l'import : le numéro de facture, jamais l'ordre des lignes.
  @@unique([clientId, numero])
}

model Contrat {
  id                   String    @id @default(cuid())
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId             String
  numero               String
  type                 String?
  dateDebut            DateTime
  dateFin              DateTime
  tacite               Boolean   @default(false)
  dateRevisionTarif    DateTime?
  // Augmentation tarifaire annuelle automatique -- optionnelle, coexiste avec
  // dateRevisionTarif (utilisée quand tauxAugmentation n'est pas renseigné).
  // Quand un taux est fixé, la date de révision se déduit de la date
  // anniversaire du contrat (dateDerniereRevision, ou dateDebut à défaut) au
  // lieu d'être ressaisie à la main -- cf lib/contracts.ts.
  montantActuel        Float?
  tauxAugmentation     Float?
  dateDerniereRevision DateTime?
  statutSource         String?
  commentaire          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  envois EnvoiContrat[]

  @@unique([clientId, numero])
}

model ActionRecouvrement {
  id       String   @id @default(cuid())
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  date     DateTime @default(now())
  palier   Int
  label    String
  note     String?

  // Qui a effectué l'action -- absent (nullable) sur toutes les actions
  // créées avant l'ajout de ce champ, et laissé tel quel : on n'attribue
  // jamais une action à un agent par supposition rétroactive.
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  utilisateurId String?
}

model EnvoiContrat {
  id           String   @id @default(cuid())
  contrat      Contrat  @relation(fields: [contratId], references: [id], onDelete: Cascade)
  contratId    String
  date         DateTime @default(now())
  label        String
  destinataire String?
  sujet        String?
  corps        String?
  statutEnvoi  String?
}

model Utilisateur {
  id                String          @id @default(cuid())
  nom               String
  email             String          @unique
  role              RoleUtilisateur
  entite            String?
  // Mise à jour à chaque appel à /api/auth/me, qui n'est fait qu'une fois par
  // ouverture/rechargement de l'app — reflète donc "la dernière fois que
  // l'app a été ouverte", pas une présence en temps réel.
  derniereConnexion DateTime?

  // Distinct du rôle : un admin peut ne jamais faire de relance (supervision,
  // configuration), et à l'inverse pourrait en faire ponctuellement. Détermine
  // qui apparaît dans le reporting "Performance par agent" — jamais déduit du
  // seul rôle à l'usage, seulement à la création/migration (voir la migration
  // pour le choix par défaut : true sauf pour les admins existants).
  estAgentRecouvrement Boolean @default(true)

  // Accès au module recouvrement lui-même (onglets Recouvrement/Contrats/
  // Planning) -- vrai par défaut pour ne rien changer aux comptes existants,
  // qui étaient tous des utilisateurs recouvrement avant l'ajout du module
  // Opérations. À mettre à false pour une directrice des opérations ou un
  // chargé de compte qui ne doit voir aucune donnée financière (cahier §7) :
  // sans ce booléen, RoleUtilisateur (obligatoire) donnerait de fait accès
  // au recouvrement à tout le monde, y compris ces profils.
  accesRecouvrement Boolean @default(true)

  // Accès au module Opérations -- absent (null) par défaut pour tous les
  // comptes existants : le module est nouveau, personne n'y a accès tant
  // qu'un admin ne l'attribue pas explicitement (cf. RoleOperations).
  roleOperations RoleOperations?

  // Accès à la console Planning des coursiers -- indépendante du recouvrement
  // depuis le découpage en consoles séparées. Défaut false, mais la migration
  // pose true pour les comptes qui avaient déjà accesRecouvrement (seul vecteur
  // d'accès au Planning auparavant) : on ne retire l'accès à personne.
  accesPlanningCoursiers Boolean @default(false)

  // Accès au SEUL onglet Contentieux, sans le reste de la console Recouvrement.
  // Destiné aux collaborateurs juridiques externes (avocat / huissier) : ils ne
  // voient que les dossiers qui LEUR sont assignés (cf. DossierContentieux.avocat)
  // et ne peuvent que consulter + valider/signer les actes. Drapeau LOCAL (jamais
  // miroir du socle SSO) : un admin l'attribue depuis Utilisateurs. Un interne
  // garde son accès via accesRecouvrement ; ce booléen est le vecteur des externes.
  accesContentieux Boolean @default(false)

  actions          ActionRecouvrement[]
  comptesOperation ClientOperations[]   @relation("ChargeDeCompte")
  dossiersContentieux DossierContentieux[] @relation("CreateurDossier")
  dossiersAssignes    DossierContentieux[] @relation("AvocatDossier")
}

// Seuils de paliers de recouvrement (jours de retard), config unique du groupe.
model Config {
  id Int @id @default(1)
  j1 Int @default(7)
  j2 Int @default(15)
  j3 Int @default(30)
  j4 Int @default(45)
  j5 Int @default(60)
  j6 Int @default(75)
  j7 Int @default(90)

  // Lien unique et partagé (pas un par coursier) pour l'écran affiché en
  // salle des coursiers -- toute l'équipe voit le planning complet du jour
  // et se dispatche les tâches elle-même, contrairement au lien personnel
  // de chaque coursier qui ne montre que ses propres tâches déjà
  // assignées. Généré à la demande (cf. routes/taches.ts), jamais à la
  // création de la config.
  salleToken String? @unique
}

// Soumission du formulaire de contact de la page vitrine publique (non
// authentifiée) — "investir" ou "devenir client pilote". Toujours persistée
// même si la notification par email échoue, pour ne jamais perdre un
// message faute de compte Gmail connecté.
enum TypeDemandeContact {
  investir
  poc
  autre
}

model DemandeContact {
  id        String             @id @default(cuid())
  type      TypeDemandeContact
  nom       String
  email     String
  societe   String?
  message   String
  createdAt DateTime           @default(now())
}

// Statut des connecteurs API externes. Les clés statiques (ARTIS, MAPON à
// venir) vivent en variables d'environnement / secret manager, jamais ici.
// Le refresh token OAuth2 de Gmail est une exception : il est généré
// dynamiquement par le flux de consentement Google et doit être persisté
// quelque part pour survivre aux redémarrages — il est donc stocké ici, mais
// n'est jamais renvoyé par l'API (voir routes/integrations.ts) et ne devrait
// pas non plus être lu en clair depuis un dump de base sans précaution.
model IntegrationCredential {
  id           String             @id @default(cuid())
  service      ServiceIntegration
  entite       String?
  statut       StatutIntegration  @default(inactif)
  derniereSync DateTime?
  compteEmail  String?
  refreshToken String?
}

// Type de course terrain -- liste fermée + "autre" en secours pour ne
// jamais bloquer la saisie d'un cas non prévu (cf. §planning coursiers).
enum TypeTacheCoursier {
  releve_compteur
  depot_facture
  depot_courrier
  recuperation_reglement
  depot_banque
  livraison_toner
  livraison_bac_recuperation
  autre
}

enum StatutTacheCoursier {
  a_faire
  faite
  annulee
}

enum ModePaiementCollecte {
  cheque
  espece
  autre
}

// Motif de report d'une tâche -- saisi par le coursier lui-même au moment
// du report (cf. routes/coursierPublic.ts), pour que l'ADV comprenne la
// raison sans avoir à le rappeler.
enum MotifReport {
  client_absent
  adresse_introuvable
  document_non_pret
  trafic_panne
  bureau_ferme
  manque_de_temps
  hors_periode
  condition_climatique
  conges_collaborateur
  panne_vehicule
  greve
  rdv_annule
  surcharge_activite
  autre
}

// Membre de l'équipe coursiers -- pas un Utilisateur de la plateforme (pas
// de rôle, pas de mot de passe) : identifié uniquement par un lien
// personnel (token) qu'il ouvre depuis son téléphone pour voir et cocher
// ses tâches du jour. Volontairement minimal pour un premier test.
model Coursier {
  id        String   @id @default(cuid())
  nom       String
  token     String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  taches TacheCoursier[]
}

// Modèle de tâche récurrente (ex: "SCL, relevé compteur, tous les 5 du
// mois") -- génère automatiquement l'instance du jour dans TacheCoursier
// quand ce jour arrive (cf. lib/taches.ts), pour que l'ADV n'ait pas à la
// ressaisir chaque mois. jourDuMois va jusqu'à 31 -- un jour qui n'existe
// pas dans un mois donné (ex: 31 en avril, 29 en février) est simplement
// sauté ce mois-là (cf. modeleDuLe), jamais reporté ni en erreur.
//
// intervalleMois (1 = tous les mois, 3 = un mois sur trois, etc.) ancre son
// décompte sur le mois de création du modèle plutôt qu'un champ séparé --
// un modèle importé aujourd'hui pour "tous les 3 mois" est donc dû ce
// mois-ci puis tous les 3 mois à partir de là (cf. modeleDuLe).
model TacheCoursierModele {
  id             String            @id @default(cuid())
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String
  type           TypeTacheCoursier
  label          String?
  jourDuMois     Int
  intervalleMois Int               @default(1)
  actif          Boolean           @default(true)
  createdAt      DateTime          @default(now())

  taches TacheCoursier[]
}

// Instance concrète d'une tâche pour un jour donné -- ponctuelle (saisie à
// la main par l'ADV) ou générée depuis un TacheCoursierModele échu.
// `date` est le jour actuellement planifié (déplaçable si l'équipe
// coursiers reporte la tâche) ; `dateInitiale` ne change jamais après
// création et sert uniquement à reconstituer, pour le récap d'une journée
// donnée, ce qui a été fait / reporté / laissé en l'état ce jour-là (cf.
// lib/taches.ts:resumeJournee).
model TacheCoursier {
  id           String              @id @default(cuid())
  // Toujours renseigné -- reflète celle du client si un client est
  // rattaché, saisi explicitement sinon (tâche générique du type "dépôt
  // banque", sans client précis). Champ à part entière plutôt que dérivé
  // du client à l'affichage : une tâche générique n'a aucune autre source
  // pour savoir de quelle société elle relève, et le filtrage par entité
  // (cf. routes/taches.ts) reste simple à un seul niveau plutôt que de
  // jongler entre "clientId null" et "entité du client".
  entite       String
  client       Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId     String?
  type         TypeTacheCoursier
  label        String?
  date         DateTime
  dateInitiale DateTime
  statut       StatutTacheCoursier @default(a_faire)

  coursier   Coursier? @relation(fields: [coursierId], references: [id], onDelete: SetNull)
  coursierId String?

  modele   TacheCoursierModele? @relation(fields: [modeleId], references: [id], onDelete: SetNull)
  modeleId String?

  // Renseignés à la clôture d'une tâche de type recuperation_reglement.
  montant      Float?
  modePaiement ModePaiementCollecte?

  note          String?
  dateExecution DateTime?

  // Renseigné par le coursier au moment du report -- absent tant que la
  // tâche n'a jamais été reportée.
  motifReport MotifReport?

  // Position dans la tournée du coursier pour la journée -- nul tant qu'il
  // n'a pas réordonné son planning (cf. routes/coursierPublic.ts), auquel
  // cas le tri retombe sur createdAt. Volontairement un simple entier plutôt
  // qu'une position relative : le coursier renvoie l'ordre complet de sa
  // journée à chaque réordonnancement (cf. reordonner), donc pas besoin de
  // gérer des décalages incrémentaux.
  ordre Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Empêche de générer deux fois l'instance du jour pour un même modèle
  // récurrent (génération idempotente, cf. lib/taches.ts).
  @@unique([modeleId, dateInitiale])
}

// ============================================================================
// Module Opérations -- suivi relationnel du portefeuille par les directrices
// des opérations de SORAM et IRIS. Domaine volontairement étanche du
// recouvrement : ne connaît ni montant ni facture (cf. cahier des charges
// OLU360 — Suivi des opérations, §1 et §7). Le seul point de jonction avec
// le recouvrement est Client.codeClient (identité partagée) et les deux
// signaux minces décrits en §8 -- jamais une jointure métier profonde, pour
// que chaque module reste isolable indépendamment de l'autre.
// ============================================================================

// Nomenclature fermée (cahier §5.1) -- 18 valeurs, 7 porteuses d'une fenêtre
// saisonnière (voir FenetreSaisonniere). Fermée par conception : ajouter un
// secteur est une migration, pas une saisie admin.
enum Secteur {
  education
  administration
  sante
  hotellerie
  distribution
  agro
  btp
  banque
  telecom
  industrie
  logistique
  maritime
  utilities
  mines
  ong
  it
  services
  autre
}

enum Criticite {
  A
  B
  C
}

// Ce que la directrice observe de la relation au moment du relevé -- alimente
// l'axe "Climat" (cf. cahier §4.3). Nommé Climat plutôt que Temperature (le
// champ du modèle JSON du prototype) pour matcher le vocabulaire du cahier
// des charges partout où l'axe est mentionné.
enum Climat {
  vert
  orange
  rouge
}

enum GraviteProbleme {
  gene
  bloquant
}

// Nomenclature fermée (cahier §5.2, annexe B) -- la distinction maîtrisable
// / subie est l'indicateur de pilotage du churn, jamais dérivée à l'affichage.
enum MotifResiliation {
  prix
  qualite
  suivi
  litige
  ao
  perimetre
  internal
  cessation
  autre
}

// Parc d'impression (gestion de flotte pour les clients suivis en COPIL,
// ex: SEN'EAU) -- domaine de données distinct du suivi de la relation
// (climat/contact/problèmes) : ici on capture l'activité opérationnelle
// réelle (machines, tickets, volumes, livraisons) qui alimente le rapport
// COPIL trimestriel. Saisie manuelle pour l'instant -- l'import depuis
// l'ERP (ARTIS) viendra une fois qu'un export réel est disponible pour en
// écrire le parseur, cf. lib/parsers.
enum StatutEquipement {
  actif
  retire
  introuvable
}

enum TypeIntervention {
  preventive
  curative
}

// Urgente/standard porte l'engagement contractuel de délai (cf. compte
// rendu COPIL : "< 4h" pour les urgentes, "< 24h" pour les standards) --
// séparé du statut ouvert/clos, qui ne dit rien du respect du délai.
enum UrgenceIntervention {
  urgente
  standard
}

enum PrioriteActionCopil {
  p1
  p2
  p3
}

enum StatutActionCopil {
  planifie
  en_cours
  fait
  bloque
}

// Extension 1:1 optionnelle de Client pour tout ce qui relève du pilotage
// opérationnel (cahier §3.1) -- volontairement une table à part plutôt que
// des colonnes sur Client lui-même : isoler le recouvrement un jour signifie
// ne pas emporter cette table (et les tables qui en dépendent), sans toucher
// une seule colonne du modèle Client existant.
model ClientOperations {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String @unique

  secteur   Secteur
  criticite Criticite @default(C)
  vip       Boolean   @default(false)

  // Chargé de compte -- référence un Utilisateur (RoleOperations =
  // charge_compte) plutôt qu'un texte libre comme dans le prototype : c'est
  // ce qui permet d'appliquer réellement la portée "ses comptes uniquement"
  // du §7 sans dépendre d'une correspondance de nom saisie à la main.
  chargeDeCompte   Utilisateur? @relation("ChargeDeCompte", fields: [chargeDeCompteId], references: [id], onDelete: SetNull)
  chargeDeCompteId String?

  debutContrat DateTime?
  finContrat   DateTime?

  dernierContact DateTime?
  climat         Climat?
  commentaire    String?

  // Engagement courant -- un seul à la fois par conception (cahier §4).
  // Une fois coché fait, il rejoint l'historique au prochain relevé plutôt
  // que d'être conservé ici.
  action         String?
  actionEcheance DateTime?
  actionFait     Boolean   @default(false)

  // Démarrage de contrat -- se déclenche à la création du compte (cahier §5.3).
  demarreLe        DateTime?
  demarrageCloture Boolean   @default(false)

  dernierCopil DateTime?
  enjeux       String?

  // Dénormalisé depuis ReleveHebdo.date (MAX) -- alimente le tri de la file
  // de relevé hebdo ("non relevés d'abord") sans recalculer un MAX() à
  // chaque affichage du portefeuille.
  dernierReleve DateTime?

  resilie          Boolean           @default(false)
  dateResiliation  DateTime?
  motifResiliation MotifResiliation?
  motifDetail      String?

  // Revue trimestrielle (comptes non-VIP uniquement -- les VIP suivent leur
  // propre cycle COPIL mensuel) : répartition mélangée du portefeuille sur
  // les semaines du trimestre en cours, posée une fois par compte puis
  // stable, pour que 100% du parc soit vu en fin de trimestre sans repasser
  // deux fois par le même compte. Recalculée à la volée (jamais de cron) —
  // cf. GET /revue-trimestre.
  revueTrimestreCle     String?
  revueTrimestreSemaine Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problemes       ProblemeOperations[]
  releves         ReleveHebdo[]
  etapesDemarrage EtapeDemarrageFait[]
  campagneFaits   CampagneFait[]

  equipementsParc   EquipementParc[]
  interventions     Intervention[]
  relevesVolumetrie ReleveVolumetrie[]
  livraisons        LivraisonConsommable[]
  actionsCopil      ActionCopil[]
}

// Un problème est un objet suivi dans le temps, pas une phrase dans un
// commentaire (cahier §3, "Pourquoi l'ancienneté compte plus que le
// nombre") -- c'est ouvertLe qui porte le poids du calcul de score, pas le
// simple fait d'exister.
model ProblemeOperations {
  id                 String           @id @default(cuid())
  clientOperations   ClientOperations @relation(fields: [clientOperationsId], references: [id], onDelete: Cascade)
  clientOperationsId String
  texte              String
  gravite            GraviteProbleme
  ouvertLe           DateTime
  resoluLe           DateTime?
}

model EquipementParc {
  id                 String           @id @default(cuid())
  clientOperations   ClientOperations @relation(fields: [clientOperationsId], references: [id], onDelete: Cascade)
  clientOperationsId String
  site               String
  modele             String
  numeroSerie        String
  statut             StatutEquipement @default(actif)
  dateInstallation   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  interventions Intervention[]
  volumetrieParMachine VolumetrieEquipement[]

  @@unique([clientOperationsId, numeroSerie])
}

// Distinct de ReleveVolumetrie (agrégat par client) -- nécessaire pour les
// alertes machine par machine du rapport COPIL (> 10 000 pages/mois,
// compteur total > 700 000 pages), que l'agrégat client seul ne permet pas
// de calculer. Alimenté uniquement par l'import ARTIS (export SSC, colonne
// "Bien facturé" = n° de série), pas de saisie manuelle pour l'instant.
model VolumetrieEquipement {
  id           String         @id @default(cuid())
  equipement   EquipementParc @relation(fields: [equipementId], references: [id], onDelete: Cascade)
  equipementId String
  periode      String
  copiesNB     Int            @default(0)
  copiesCouleur Int           @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([equipementId, periode])
}

// datePriseEnCharge et dateCloture nullables à dessein : un ticket qui
// vient d'être déclaré n'a ni l'un ni l'autre pour l'instant -- c'est cet
// écart qui manquait au COPIL T2 SEN'EAU (cf. compte rendu : "un rapport de
// suivi des SLA faisant apparaître... l'heure de déclaration... et l'heure
// de début de prise en charge").
model Intervention {
  id                 String              @id @default(cuid())
  clientOperations   ClientOperations    @relation(fields: [clientOperationsId], references: [id], onDelete: Cascade)
  clientOperationsId String
  equipement         EquipementParc?     @relation(fields: [equipementId], references: [id], onDelete: SetNull)
  equipementId       String?
  site               String
  type               TypeIntervention    @default(curative)
  urgence            UrgenceIntervention @default(standard)
  panne              String?
  dateDeclaration    DateTime
  datePriseEnCharge  DateTime?
  dateCloture        DateTime?
  referenceExterne   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([clientOperationsId, referenceExterne])
}

// Une ligne par période (mois) plutôt qu'un relevé de compteur brut -- les
// COPIL raisonnent en volumes mensuels agrégés (cahier du COPIL T2 : "avril
// / mai"), pas en relevé compteur instantané comme le suivi de démarrage.
model ReleveVolumetrie {
  id                 String           @id @default(cuid())
  clientOperations   ClientOperations @relation(fields: [clientOperationsId], references: [id], onDelete: Cascade)
  clientOperationsId String
  periode            String // "2026-04"
  copiesNB           Int              @default(0)
  copiesCouleur      Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([clientOperationsId, periode])
}

model LivraisonConsommable {
  id                 String           @id @default(cuid())
  clientOperations   ClientOperations @relation(fields: [clientOperationsId], references: [id], onDelete: Cascade)
  clientOperationsId String
  date               DateTime
  reference          String
  quantite           Int              @default(1)
  referenceExterne   String?
  createdAt          DateTime         @default(now())

  @@unique([clientOperationsId, referenceExterne])
}

// Plan d'action du COPIL (P1/P2/P3, plusieurs lignes en parallèle) --
// distinct du champ "action" unique de ClientOperations, qui sert le rythme
// hebdomadaire du relevé, pas le plan trimestriel du COPIL.
model ActionCopil {
  id                 String              @id @default(cuid())
  clientOperations   ClientOperations    @relation(fields: [clientOperationsId], references: [id], onDelete: Cascade)
  clientOperationsId String
  priorite           PrioriteActionCopil @default(p2)
  action             String
  responsable        String?
  echeance           DateTime?
  statut             StatutActionCopil   @default(en_cours)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// Une entrée par semaine ISO (cahier §3.1) -- @@unique garantit l'écrasement
// si un second relevé est validé la même semaine plutôt que d'empiler deux
// lignes. La fenêtre glissante de 52 entrées est une politique de
// consultation/purge, pas une contrainte de schéma : voir lib/operations.ts.
model ReleveHebdo {
  id                 String           @id @default(cuid())
  clientOperations   ClientOperations @relation(fields: [clientOperationsId], references: [id], onDelete: Cascade)
  clientOperationsId String
  semaineIso         String
  date               DateTime         @default(now())
  score              Int
  commentaire        String?
  action             String?

  @@unique([clientOperationsId, semaineIso])
}

// Progression du démarrage de contrat -- une ligne par étape cochée (cahier
// §5.3). Les étapes elles-mêmes (libellé, délai, ordre) sont configurables
// par entité, voir EtapeDemarrageConfig : cette table ne stocke que "cochée
// le", jamais le libellé ni le délai, pour ne pas devoir migrer les faits
// passés si une échéance est ajustée en administration.
model EtapeDemarrageFait {
  id                 String           @id @default(cuid())
  clientOperations   ClientOperations @relation(fields: [clientOperationsId], references: [id], onDelete: Cascade)
  clientOperationsId String
  cle                String
  date               DateTime         @default(now())

  @@unique([clientOperationsId, cle])
}

// Étapes de démarrage paramétrables par entité (cahier §5.3 + §10 : "délais
// paramétrables"). SORAM et IRIS ont les mêmes clés d'étape mais des
// libellés et délais distincts -- seedées à la migration avec les valeurs du
// cahier, ajustables ensuite depuis l'administration.
model EtapeDemarrageConfig {
  id          String  @id @default(cuid())
  entite      String
  cle         String
  libelle     String
  // Précision affichée sous le libellé (ex. "Formation, paramétrage,
  // dispatch des contacts internes" sous "Client opérationnel") -- distincte
  // du libellé lui-même pour matcher la fiche compte du cahier des charges,
  // qui affiche les deux sur des lignes séparées plutôt que concaténées.
  description String?
  delaiJours  Int
  ordre       Int

  @@unique([entite, cle])
}

// Fenêtre saisonnière par secteur (cahier §5.1) -- seuls les 7 secteurs qui
// en portent une ont une ligne ici ; les autres en sont simplement absents.
// mois/jour plutôt qu'une date absolue : la fenêtre se reproduit chaque
// année à date fixe (calendrier sénégalais), pas une échéance ponctuelle.
model FenetreSaisonniere {
  secteur           Secteur @id
  label             String
  mois              Int
  jour              Int
  anticipationJours Int
}

// Traiter plusieurs comptes d'un même secteur en une opération (cahier §7).
// Les cibles ne sont jamais stockées : recalculées à l'affichage depuis
// secteurs + entite sur les clients actifs, pour qu'un nouveau client du
// secteur rejoigne automatiquement une campagne en cours -- voir
// lib/operations.ts.
model Campagne {
  id       String    @id @default(cuid())
  nom      String
  objectif String?
  secteurs Secteur[]
  entite   String
  echeance DateTime
  creeLe   DateTime  @default(now())
  cloturee Boolean   @default(false)

  faits CampagneFait[]
}

model CampagneFait {
  id                 String           @id @default(cuid())
  campagne           Campagne         @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  campagneId         String
  clientOperations   ClientOperations @relation(fields: [clientOperationsId], references: [id], onDelete: Cascade)
  clientOperationsId String
  date               DateTime         @default(now())
  note               String?

  @@unique([campagneId, clientOperationsId])
}

// Seuils du module Opérations (cahier §4.2 et annexe des seuils) -- config
// unique du groupe, même convention que le modèle Config du recouvrement
// (id=1 fixe, une seule ligne).
model ConfigOperations {
  id Int @id @default(1)

  contactStdVigilance Int @default(45)
  contactStdRisque    Int @default(60)
  contactVipVigilance Int @default(25)
  contactVipRisque    Int @default(35)

  problemeVigilanceJours      Int @default(14)
  problemeRisqueJours         Int @default(30)
  problemeBloquantRisqueJours Int @default(7)

  demarrageRisqueRetardJours Int @default(15)

  finContratVigilanceJours Int @default(90)
  finContratRisqueJours    Int @default(30)
}

// =====================================================================
// MODULE CONTENTIEUX — « Copilote Contentieux »
// ---------------------------------------------------------------------
// Fait passer une créance de l'amiable au judiciaire (cadre OHADA /
// AUPSRVE : injonction de payer). L'IA prépare (analyse + décompte +
// checklist) ; un huissier ou un avocat valide et signe. Voir la note de
// cadrage du module. Aucune donnée juridique n'est inventée : chaque
// montant/date est rattaché à une pièce, et les actes générés sont des
// PROJETS à faire valider par le professionnel.
// =====================================================================

enum StatutDossierContentieux {
  ouvert     // créé, pièces en cours de dépôt
  analyse    // analyse IA produite
  pret       // recevable, prêt à transmettre au professionnel
  transmis   // remis à l'huissier / avocat
  depose     // déposé au tribunal
  clos       // recouvré ou classé sans suite
}

// Verdict de recevabilité (synthèse de l'analyse OHADA).
enum VerdictRecevabilite {
  non_evalue
  pret         // créance certaine, liquide, exigible + pièces complètes
  a_completer  // recevable sur le fond mais pièces manquantes
  risque       // prescription probable, créance non certaine, etc.
}

// Type de pièce versée au dossier (sert au classement et à la checklist).
enum TypePiece {
  facture
  bon_commande
  contrat
  mise_en_demeure
  preuve_livraison
  echange           // e-mail / WhatsApp / courrier
  releve_de_compte
  autre
}

// Actes réellement pratiqués par les huissiers au Sénégal (calqués sur les
// modèles fournis par l'étude) :
//  - commandement_de_payer : l'huissier somme le débiteur de payer sous 8 jours.
//  - assignation_en_paiement : commandement qui vaut aussi assignation à
//    comparaître devant le Tribunal de commerce (rappel art. 33 CPC, exposé
//    des faits, « PAR CES MOTIFS », bordereau de pièces).
enum TypeActe {
  mise_en_demeure
  commandement_societe     // étape 1 : commandement émis par la société créancière, sur son entête (≈ 90 j)
  commandement_de_payer    // étape 2 : commandement de payer signifié par huissier
  assignation_en_paiement  // étape 3 : commandement valant assignation devant le tribunal
  decompte_de_creance
  bordereau_de_pieces
}

enum StatutActe {
  brouillon   // projet généré par l'IA, non relu
  valide      // relu par le professionnel
  signe       // signé, prêt au dépôt
}

model DossierContentieux {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  reference String                   @unique // référence lisible « CONT-AAAA-NNNN », générée à la création
  statut    StatutDossierContentieux @default(ouvert)
  verdict   VerdictRecevabilite      @default(non_evalue)

  // Montant réclamé = somme des postes du décompte (principal + intérêts +
  // pénalités + frais). Recalculé à chaque analyse, jamais saisi à la main.
  montantReclame Float?

  // Créé par (auteur du dossier) — SetNull pour conserver l'historique si le
  // compte est supprimé, comme ActionRecouvrement.
  createur   Utilisateur? @relation("CreateurDossier", fields: [createurId], references: [id], onDelete: SetNull)
  createurId String?

  // Avocat / huissier assigné au dossier. Un collaborateur juridique externe
  // (accesContentieux) ne voit QUE les dossiers où il figure ici. SetNull pour
  // ne pas perdre le dossier si le compte est supprimé.
  avocat   Utilisateur? @relation("AvocatDossier", fields: [avocatId], references: [id], onDelete: SetNull)
  avocatId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factures Facture[]
  pieces   PieceContentieux[]
  analyse  AnalyseContentieux?
  decompte LigneDecompte[]
  actes    ActeContentieux[]

  @@index([clientId])
  @@index([avocatId])
}

// Pièce versée au dossier. Le contenu binaire est stocké en base (bytea) pour
// que le module soit autonome (pas de dépendance à un stockage objet pour le
// MVP). ocrTexte / extraitJson sont remplis par l'analyse IA.
model PieceContentieux {
  id        String             @id @default(cuid())
  dossier   DossierContentieux @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId String

  type       TypePiece @default(autre)
  nomFichier String
  mimeType   String
  contenu    Bytes // le fichier lui-même
  taille     Int

  ocrTexte    String? // texte extrait par l'IA (aperçu)
  extraitJson Json? // faits structurés extraits (montant, date, référence…)

  createdAt      DateTime        @default(now())
  lignesDecompte LigneDecompte[] // postes du décompte sourcés sur cette pièce

  @@index([dossierId])
}

// Résultat de l'analyse OHADA d'un dossier (1 par dossier, remplacé à chaque
// relance de l'analyse). Les trois conditions de l'injonction de payer +
// prescription + pièces manquantes + compétence.
model AnalyseContentieux {
  id        String             @id @default(cuid())
  dossier   DossierContentieux @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId String             @unique

  certaine       Boolean // la dette est-elle prouvée par une pièce ?
  liquide        Boolean // le montant est-il chiffré et justifié ?
  exigible       Boolean // l'échéance est-elle dépassée ?
  prescriptionOk Boolean // la créance est-elle encore dans les délais ?

  manquants   String[] // pièces / éléments manquants (checklist)
  competence  String? // juridiction compétente (domicile du débiteur)
  syntheseIa  String? // synthèse rédigée par l'IA
  modeleIa    String? // modèle Claude utilisé (traçabilité)
  createdAt   DateTime @default(now())
}

// Un poste du décompte de créance, rattaché à une pièce justificative.
model LigneDecompte {
  id        String             @id @default(cuid())
  dossier   DossierContentieux @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId String

  poste   String // « Principal facture 2024-114 », « Intérêts de retard »…
  montant Float

  // Source : la pièce qui justifie ce montant (SetNull si la pièce est retirée
  // — on garde la ligne, mais elle devient « non sourcée » et ressort en alerte).
  sourcePiece   PieceContentieux? @relation(fields: [sourcePieceId], references: [id], onDelete: SetNull)
  sourcePieceId String?

  @@index([dossierId])
}

// Acte généré (PROJET). Fichier produit à partir d'un gabarit versionné.
// Reste au statut brouillon tant qu'un professionnel ne l'a pas validé/signé.
model ActeContentieux {
  id        String             @id @default(cuid())
  dossier   DossierContentieux @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId String

  type           TypeActe
  gabaritVersion String // ex. « injonction-de-payer/v0.1 » — traçabilité juridique
  contenu        Bytes // le document (PDF)
  mimeType       String     @default("application/pdf")
  statut         StatutActe @default(brouillon)

  // Cycle de validation humain-dans-la-boucle : un professionnel relit le
  // PROJET (valideParId + valideLe), puis dépose la version signée scannée
  // (contenuSigne) qui fait passer le statut à « signe ». On conserve toujours
  // le projet d'origine dans `contenu` à côté de la version signée.
  valideParId   String?
  valideLe      DateTime?
  contenuSigne  Bytes?
  mimeTypeSigne String?
  signeLe       DateTime?
  createdAt     DateTime @default(now())

  @@index([dossierId])
}
