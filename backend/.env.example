DATABASE_URL="postgresql://user:password@localhost:5432/recouvrement?schema=public"
PORT=3000

# Your Supabase project URL (Project Settings > General). Used to fetch the
# project's public JWKS to verify real Supabase-issued user tokens — no
# shared secret needed for this (Supabase's newer projects use rotating
# asymmetric signing keys instead of a single JWT secret).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Dev/test only: shared secret used to sign tokens minted by
# /api/auth/dev-token, for testing protected routes without a live Supabase
# project. Never used to verify real Supabase tokens, and the dev-token
# route itself is disabled outside NODE_ENV=development regardless.
SUPABASE_JWT_SECRET=dev-secret-for-local-testing-only

# development | production — controls whether /api/auth/dev-token (local
# testing helper, no real Supabase project needed) is enabled. Must never be
# "development" in a deployed environment.
NODE_ENV=development

# Google Cloud OAuth2 client (Console > APIs & Services > Credentials) for
# the dedicated Gmail account (ex: recouvrement@soram-afrique.com). Redirect
# URI must be registered on the OAuth client and point at this backend's
# /api/integrations/gmail/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Optional: if set, the Gmail OAuth callback redirects back here (?gmail=connected
# or ?gmail=error) instead of showing a plain confirmation page.
FRONTEND_URL=http://localhost:5173

# Anthropic API key for the in-app assistant (floating chat bubble,
# /api/assistant/chat). Create/retrieve one at
# https://console.anthropic.com/settings/keys — the same key can serve
# multiple apps, billing is per-organization, not per-app. Leave unset to
# disable the assistant (the route returns 503, the rest of the app is
# unaffected).
ANTHROPIC_API_KEY=

# Optional: override the model used by the assistant. Defaults to
# claude-sonnet-5 if unset.
ASSISTANT_MODEL=
