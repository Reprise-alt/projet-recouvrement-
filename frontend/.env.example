VITE_API_URL=http://localhost:3000

# Authentification réelle (production) — projet Supabase du groupe.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Active l'écran de connexion "dev" (utilise /api/auth/dev-token du backend)
# pour tester sans projet Supabase connecté. Ne jamais mettre à "true" en prod.
VITE_ALLOW_DEV_LOGIN=true
